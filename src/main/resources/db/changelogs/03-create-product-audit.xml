<?xml version="1.1" encoding="UTF-8" standalone="no"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:ext="http://www.liquibase.org/xml/ns/dbchangelog-ext"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog-ext
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-ext.xsd
    http://www.liquibase.org/xml/ns/dbchangelog
    https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet author="onboarding1" id="20240313-create-product-audit-table">
        <comment>Створення таблиці аудиту таблиці product</comment>
        <createTable tableName="product_aud" ifNotExists="true">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="changed_at" type="TIME"/>
            <column name="operation" type="VARCHAR(255)"/>
            <column name="product_id" type="BIGINT"/>
            <column name="product_name" type="VARCHAR(255)"/>
            <column name="product_price" type="BIGINT"/>
        </createTable>
    </changeSet>

    <changeSet author="onboarding1" id="20240313-create-auditlog-function-for-product" >
        <sqlFile path="db/scripts/auditlog_product_trigger_function.sql"
                 relativeToChangelogFile="false"
                 splitStatements="false"
                 stripComments="true"
                 endDelimiter=";"/>
        <rollback>
            DROP FUNCTION IF EXISTS auditlog_product();
        </rollback>
    </changeSet>

    <changeSet author="onboarding1" id="20240313-create-trigger-for-product">
        <sqlFile path="db/scripts/create_trigger_auditing_product.sql"
                 relativeToChangelogFile="false"
                 splitStatements="false"
                 stripComments="true"
                 endDelimiter=";"/>
        <rollback>
            DROP TRIGGER IF EXISTS auditing_product ON product;
        </rollback>
    </changeSet>

</databaseChangeLog>